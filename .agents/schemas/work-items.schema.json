{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S7-EVSN work items",
  "type": "object",
  "required": ["project", "last_updated", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "project": { "const": "S7-EVSN" },
    "last_updated": { "type": "string", "format": "date" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "area",
          "title",
          "desired_outcome",
          "status",
          "plan_path",
          "acceptance_criteria",
          "verification_commands",
          "evidence",
          "dependencies",
          "blockers",
          "notes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^VSN-[0-9]{4}$" },
          "priority": { "type": "integer", "minimum": 1 },
          "area": { "type": "string" },
          "title": { "type": "string" },
          "desired_outcome": { "type": "string" },
          "status": { "enum": ["not_started", "in_progress", "blocked", "passing"] },
          "plan_path": { "type": ["string", "null"] },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
          "verification_commands": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "pattern": "^VSN-[0-9]{4}$" }
          },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
