# Authenticate Docker to ECR, copy this file to docker/.env, and replace the
# image reference with the ECR repository output from the Dev-Env-Builder stack.
DEV_ENV_BUILDER_IMAGE=ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/dev-env-builder:dev-env-builder-amd64-latest

# Optional when the image contains more than one QNX RTI target architecture.
# CONNEXTDDS_ARCH=x64QNX...

# Optional. The dev-env-builder service attempts to add a 224.0.0.0/4 multicast
# route for UDP multicast tests when the builder image contains iproute2. Set to
# 0 to disable that startup step.
# DEV_ENV_ENABLE_MULTICAST_ROUTE=1
