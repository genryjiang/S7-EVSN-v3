#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/.." && pwd)"

git -C "${repo_root}" diff --check
bash -n "${script_dir}"/*
"${script_dir}/linux-test" --clean

if [[ "${VERIFY_QNX:-0}" == "1" ]]; then
  "${script_dir}/qnx-build"
else
  echo "Skipping QNX cross-build. Set VERIFY_QNX=1 to require it."
fi
