#!/usr/bin/env bash
set -euo pipefail

: "${QNX_HOST:?QNX_HOST must point at the QNX host SDK root}"

compiler="${QNX_HOST}/usr/bin/aarch64-unknown-nto-qnx8.0.0-g++-12.2.0"
args=()

for arg in "$@"; do
  case "${arg}" in
    -Vgcc*|-Y_cxx)
      ;;
    *)
      args+=("${arg}")
      ;;
  esac
done

exec "${compiler}" "${args[@]}"
